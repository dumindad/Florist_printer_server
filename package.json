{
  "name": "printer_server",
  "version": "1.0.0",
  "description": "POS Printer Server — WebSocket + HTTPS server for thermal/USB label and receipt printing",
  "main": "print.js",
  "scripts": {
    "start": "node print.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "pnpm exec pkg print.js --targets node20-win-x64 --output dist/printer-server.exe && node scripts/postbuild.js",
    "package": "powershell -ExecutionPolicy Bypass -File build-installer.ps1",
    "release": "pnpm build && pnpm package",
    "gen-certs": "node scripts/gen-certs.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp", "@img/sharp-win32-x64", "@img/sharp-libvips-win32-x64", "esbuild", "usb", "escpos-usb"]
  },
  "pkg": {
    "scripts": [
      "print.js"
    ],
    "assets": [
      "node_modules/usb/**/*",
      "node_modules/**/build/Release/*.node",
      "node_modules/sharp/vendor/**/*",
      "node_modules/@img/**/*",
      "images/**/*"
    ]
  },
  "keywords": [],
  "author": "duminda",
  "license": "ISC",
  "dependencies": {
    "@img/sharp-libvips-win32-x64": "^1.2.4",
    "@img/sharp-win32-x64": "^0.34.5",
    "@types/ws": "^8.18.0",
    "escpos": "3.0.0-alpha.6",
    "escpos-usb": "3.0.0-alpha.4",
    "sharp": "^0.32.6",
    "usb": "1.9.2",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.14.1"
  }
}
